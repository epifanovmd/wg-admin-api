# Копия для окружения: .env.development (yarn dev) или .env.production (Docker).
# Скомпилированный запуск без NODE_ENV работает как production.

# ─── Docker Compose (.env.production — env-file compose) ──────────────────────
# Образ и тег при запуске compose напрямую (make берёт их из .env.deploy).
# Версию сборки (APP_VERSION — git describe, APP_COMMIT — короткий SHA,
# APP_BUILT_AT — время; /api/v1/app/version, /health, Sentry) передаёт make
# build-аргументами; в .env их задавать не нужно
# IMAGE=ghcr.io/epifanovmd/wg-admin
# TAG=latest
# Порт(ы) API на хосте; диапазон — для нескольких реплик (8181-8183)
# API_PORTS=8181

# ─── App / Server ─────────────────────────────────────────────────────────────
APP_NAME=wg-admin
# Роль процесса: api (HTTP + сокеты), worker (задачи и cron), all (оба — dev, один инстанс)
APP_ROLE=all
# Публичный URL API: ссылки в письмах, команда установки агента, адрес бэкенда
# для агентов нод
APP_PUBLIC_URL=http://localhost:8181
# За HTTPS reverse proxy инфраструктуры — https://<домен>.
SERVER_HOST=0.0.0.0
SERVER_PORT=8181
# true — за доверенным reverse proxy (IP и протокол клиента из X-Forwarded-*)
TRUST_PROXY=false
# Swagger UI на /api-docs; по умолчанию выключен в production
API_DOCS_ENABLED=
# Дополнительные адреса в servers Swagger через запятую (удалённые стенды)
API_DOCS_SERVERS=

# ─── Задачи (pg-boss) ────────────────────────────────────────────────────────
JOBS_CONCURRENCY=4
JOBS_SHUTDOWN_TIMEOUT_MS=20000
JOBS_POOL_MAX=4
# Сколько дней хранить завершённые записи задач (статус, результат, лог)
JOBS_RETENTION_DAYS=30

# ─── Наблюдаемость ───────────────────────────────────────────────────────────
METRICS_ENABLED=true
# Bearer-токен для /metrics; пусто — закрывать сетью
METRICS_TOKEN=
SENTRY_DSN=

# ─── Остановка (SIGTERM) ─────────────────────────────────────────────────────
# пауза после /ready → 503 (production: 5000), ожидание in-flight, общий предел
SHUTDOWN_DRAIN_MS=
SHUTDOWN_INFLIGHT_TIMEOUT_MS=10000
SHUTDOWN_TIMEOUT_MS=45000

# ─── Логи ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=

# ─── Redis (обязателен в production) ─────────────────────────────────────────
# Общие лимиты запросов, отзыв токенов и Socket.IO между репликами
REDIS_URL=redis://localhost:6379
# Префикс ключей и каналов (`wg_admin:`) — в общем Redis с ACL по префиксу; пусто — без
REDIS_KEY_PREFIX=

# ─── Rate limit ───────────────────────────────────────────────────────────────
# Запросов с одного IP за окно
RATE_LIMIT=1000
RATE_LIMIT_INTERVAL=900000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Через запятую; `*` недопустим в production
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
# не короче 32 символов: openssl rand -base64 48
JWT_SECRET_KEY=change-me-to-a-random-secret-of-32-plus-chars
# срок access-токена (jsonwebtoken: 15m, 1h; в development по умолчанию 1d) и refresh-токена в днях
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
# Refresh-токен дополнительно в httpOnly-cookie (веб-клиенты)
AUTH_REFRESH_COOKIE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars

# ─── OTP / Reset password ─────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
RESET_PASS_TOKEN_EXPIRE_MINUTES=60
WEB_URL_RESET_PASSWORD=http://localhost:3000/reset-password?token={{token}}

# ─── WebAuthn / Passkeys ──────────────────────────────────────────────────────
WEB_AUTHN_RP_NAME=WG Admin
WEB_AUTHN_RP_HOST=localhost
WEB_AUTHN_RP_SCHEMA=http
WEB_AUTHN_RP_PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wg_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SSL=false
# PEM CA сервера (если провайдер выдаёт); false — не проверять сертификат (только dev)
POSTGRES_SSL_CA=
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# пул на реплику; сумма по репликам < max_connections Postgres
POSTGRES_POOL_MAX=10
POSTGRES_CONNECTION_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_SLOW_QUERY_MS=1000
# применять миграции при старте (под advisory-lock); false — миграции отдельным шагом
DB_MIGRATIONS_RUN=true

# ─── SMTP ─────────────────────────────────────────────────────────────────────
# Пусто — почта выключена: в production отправка отвечает 503, в dev письмо в лог.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, пароль приложения в SMTP_PASS.
# Локально: Mailpit из docker-compose.dev.yml — SMTP_HOST=localhost SMTP_PORT=1025 SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=465
# true — TLS сразу (465); false — STARTTLS (587) или без шифрования (локально)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Адрес отправителя; по умолчанию SMTP_USER
SMTP_FROM=

# ─── WireGuard-домен ─────────────────────────────────────────────────────────
# Ключ AES-256-GCM для приватных ключей/PSK/SSH в БД: 32 байта hex или base64.
# Обязателен в production (openssl rand -hex 32); пусто вне production —
# производный dev-ключ.
WG_SECRETS_KEY=
# Хранение статистики
WG_STATS_SAMPLE_RETENTION_DAYS=31
WG_STATS_HOUR_RETENTION_DAYS=366
WG_NODE_METRIC_RETENTION_DAYS=14
# Подсеть /30-блоков IPIP-туннелей релеев
WG_RELAY_TUNNEL_CIDR=10.99.0.0/16

# ─── Агенты на нодах (github.com/epifanovmd/agent) ───────────────────────────
# Версия агента: её скачивают yarn agent / agent:fetch, образ (build-arg AGENT_VERSION) и e2e.
AGENT_VERSION=1.0.0
# Общий токен регистрации (не короче 32 символов): агенты в dev (yarn agent) и
# стендах регистрируются без создания токена. На ноды ставят токеном ноды
# (POST /api/v1/wg/nodes/{id}/install-command) — без этой переменной.
# AGENT_BOOTSTRAP_TOKEN=
# Архивы папки агента для узлов (yarn agent:pack → agent/bundle; в образе —
# /app/agent/bundle): по ним ставятся узлы (команда установки, SSH), release/ в нём —
# подписанные сборки воркеров wg и socks для их обновления. Пусто — узлы с API не ставятся.
# AGENT_BUNDLE_DIR=agent/bundle
# Шифрование значений настроек воркеров в БД (в них приватные ключи WireGuard):
# 32 байта hex или base64 (openssl rand -hex 32); можно тем же, что WG_SECRETS_KEY.
AGENT_CONFIGS_KEY=
# Адрес бэкенда для агентов (команда установки, ссылки); без него — APP_PUBLIC_URL.
# AGENT_PUBLIC_URL=
# Частота состояния и метрик агентов (при открытой админке метрики — раз в секунду), мс.
# AGENT_STATE_INTERVAL_MS=30000
# AGENT_METRICS_INTERVAL_MS=15000
# Точку метрик в историю — не чаще, мс; сколько хранить историю, часов.
# AGENT_METRICS_STORE_INTERVAL_MS=60000
# AGENT_METRICS_RETENTION_HOURS=168
# Сколько дней хранить события воркеров и выполненные команды.
# AGENT_EVENTS_RETENTION_DAYS=14

# ─── Тесты ───────────────────────────────────────────────────────────────────
# Интеграционный тест очереди задач: одноразовая база (схема pgboss и job_runs
# пересоздаются); без переменной тест пропускается
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/wg_admin_jobs_test
# Пакетные операции живого хранилища на настоящем Redis (база очищается).
# TEST_REDIS_URL=redis://localhost:6379/14
