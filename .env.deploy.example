# Настройки деплоя (скопировать в .env.deploy). Формат make: КЛЮЧ=значение, без кавычек и `$`.
# Любое значение можно переопределить в команде: make deploy SSH_HOST=203.0.113.10

SSH_HOST=example.com
SSH_USER=root
SSH_PROJECT_DIR=development/wg-admin-api
# Опции ssh/scp/rsync (по умолчанию — таймаут, повтор соединения, keepalive):
# SSH_OPTS=-o ConnectTimeout=15 -o ConnectionAttempts=5 -o ServerAliveInterval=30

# Секреты приложения на хосте
ENV_FILE=.env.production

# Состав стека: свои Redis и Postgres — файлы redis/postgres; общая инфраструктура
# хоста (репозиторий infra) — только docker-compose.infra.yml (учётки проекта в ENV_FILE)
COMPOSE_FILES=docker-compose.yml docker-compose.redis.yml docker-compose.postgres.yml
# COMPOSE_FILES=docker-compose.yml docker-compose.infra.yml
# Профили через запятую; пусто — без дополнительных сервисов
COMPOSE_PROFILES=

# Образ из registry (make release)
IMAGE=ghcr.io/epifanovmd/wg-admin

# База для db-dump / db-restore; DB_DUMP_FILE — файл дампа (по умолчанию — новый / самый свежий)
DB_CONTAINER=wg-admin-postgres-1
DB_USER=postgres
DB_NAME=postgres
DB_DUMP_FILE=
