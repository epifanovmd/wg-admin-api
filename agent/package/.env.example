# Скопируйте в .env и заполните. Токен регистрации выдаёт бэкенд (страница ноды или агентов);
# он нужен только до первой регистрации — потом агент работает по своему ключу.
AGENT_SERVER_URL=https://api.example.com
AGENT_ENROLL_TOKEN=
# Имя агента на бэкенде (по умолчанию — имя машины; выданный для ноды архив — имя ноды).
AGENT_NAME=
# Адрес http:// — только с этим разрешением: ключ агента и данные идут открытым текстом.
# AGENT_SERVER_ALLOW_INSECURE=true
