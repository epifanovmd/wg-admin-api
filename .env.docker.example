# Локальный production-стек (make local-up): api, worker, migrate и свои Postgres и Redis
# в Docker. make local-up копирует этот файл в .env.docker, если его нет; правки — в .env.docker.
# Значения — только для этой машины. Полный список переменных — .env.example.
API_PORTS=127.0.0.1:8182
APP_PUBLIC_URL=http://localhost:8182
API_DOCS_ENABLED=true
# Фронт wg-admin-web: yarn dev (3001) и Docker (4175)
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:4175
WEB_URL_RESET_PASSWORD=http://localhost:3001/reset-password?token={{token}}
WEB_AUTHN_RP_PORT=3001

JWT_SECRET_KEY=local-docker-secret-key-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-password

POSTGRES_DB=wg_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ключи шифрования в БД (WG_SECRETS_KEY обязателен в production): 32 байта hex
WG_SECRETS_KEY=6dd21e5494f1e736046e308e5618dc3610699800e690c942097af4271c9b535a
AGENT_CONFIGS_KEY=20083f53d7d3994fd4826c77ba21f1d30a1dffc83927cf1313099442faad3d2b
# Токен регистрации агентов стека (yarn agent с ENV_FILE=.env.docker SERVER_PORT=8182)
AGENT_BOOTSTRAP_TOKEN=local-docker-agent-bootstrap-token-0123456789
