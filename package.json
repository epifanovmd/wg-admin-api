{
  "name": "wg-admin",
  "version": "1.0.1",
  "description": "WG Admin — админка WireGuard: бэкенд (Koa, tsoa, TypeORM, pg-boss) и воркеры агента нод на Go",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "homepage": "https://github.com/epifanovmd/wg-admin-api#readme",
  "author": {
    "name": "Epifanov Andrei",
    "email": "epifanovmd@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/epifanovmd/wg-admin-api.git"
  },
  "scripts": {
    "dev": "yarn generate && NODE_ENV=development tsx watch --clear-screen=false src/main.ts",
    "dev:types": "tsc --noEmit --watch --preserveWatchOutput",
    "build": "yarn generate && rm -rf build && tsc -p tsconfig.build.json",
    "server": "NODE_ENV=production node --enable-source-maps build/main.js",
    "generate": "tsoa spec-and-routes",
    "test": "NODE_ENV=test mocha",
    "test:file": "NODE_ENV=test mocha --no-config --require tsx --timeout 10000",
    "test:e2e": "mocha --config .mocharc.e2e.yml",
    "lint": "eslint src test",
    "lint:fix": "eslint --fix src test",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "migration:generate": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:run": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "NODE_ENV=development tsx ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "typecheck": "tsc --noEmit",
    "gen:module": "node scripts/gen-module.mjs",
    "agent": "agent/dev.sh run",
    "agent:start": "agent/dev.sh start",
    "agent:stop": "agent/dev.sh stop",
    "agent:status": "agent/dev.sh status",
    "agent:logs": "agent/dev.sh logs",
    "agent:release": "agent/release.sh",
    "agent:fetch": "agent/fetch-agent.sh",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^14",
    "@peculiar/x509": "^2.1.0",
    "@sentry/node": "^11.0.0",
    "@simplewebauthn/server": "^14",
    "@socket.io/redis-adapter": "^8.3.0",
    "@tsoa/runtime": "6.6.0",
    "agent-sdk": "https://github.com/epifanovmd/agent/releases/download/v1.1.0/agent-sdk-1.1.0.tgz",
    "bcrypt": "^6.0.0",
    "ejs": "^6",
    "helmet": "^8",
    "inversify": "^8",
    "ioredis": "^6",
    "jsonwebtoken": "^9.0.3",
    "koa": "^3.2.1",
    "koa-helmet": "^9",
    "koa-ratelimit": "^6",
    "koa2-swagger-ui": "^5.12.0",
    "nodemailer": "^10",
    "pg": "^8.23.0",
    "pg-boss": "^12",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "ssh2": "^1.17.0",
    "tsoa": "6.6.0",
    "typeorm": "^1.1.1",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tsoa/cli": "6.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9",
    "@types/koa": "^3",
    "@types/koa-ratelimit": "^5.0.5",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24",
    "@types/nodemailer": "^8",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sinon": "^22",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "chai": "^6.2.2",
    "eslint": "^10",
    "eslint-plugin-simple-import-sort": "^14",
    "lefthook": "^2",
    "mocha": "^12",
    "pino-pretty": "^13.1.3",
    "prettier": "^3",
    "sinon": "^22",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8"
  },
  "resolutions": {
    "**/@types/koa": "^3.0.3",
    "**/handlebars": "^4.7.10"
  }
}
