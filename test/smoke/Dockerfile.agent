# syntax=docker/dockerfile:1.7
# Агент ноды в контейнере — для smoke-стенда (test/smoke/wg-smoke.sh). На
# нодах агент ставится install.sh как служба systemd (agent/README.md).
# Сборка из корня репозитория:
#   docker build -f test/smoke/Dockerfile.agent --build-arg AGENT_VERSION=2.0.0-smoke -t wg-admin-agent:test .
# AGENT_VERSION — версия вместо agent/VERSION: smoke обновляет агента на
# релизный бинарь бэкенда, поэтому бинарь образа должен от него отличаться.
ARG GO_VERSION=1.26-bookworm

FROM --platform=$BUILDPLATFORM golang:${GO_VERSION} AS build
ARG TARGETARCH
ARG AGENT_VERSION=""
WORKDIR /agent
COPY agent/go.mod agent/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY agent/ ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
      -ldflags "-s -w -X main.version=${AGENT_VERSION:-$(cat VERSION)}" \
      -o /out/wg-admin-agent ./cmd/wg-admin-agent

FROM debian:bookworm-slim
# wireguard-go — userspace-замена модулю ядра (например, в Docker Desktop).
RUN apt-get update && apt-get install -y --no-install-recommends \
      wireguard-tools wireguard-go iproute2 iptables iputils-ping conntrack \
      procps ca-certificates tini >/dev/null && \
    rm -rf /var/lib/apt/lists/*
COPY --from=build /out/wg-admin-agent /usr/local/bin/wg-admin-agent
# Конфиги и состояние агента — в /etc/wireguard контейнера (smoke проверяет
# там маркер обновления); тот же образ служит клиентом wg-quick.
ENV WG_AGENT_CONFIG_DIR=/etc/wireguard
ENTRYPOINT ["tini", "--", "/usr/local/bin/wg-admin-agent"]
